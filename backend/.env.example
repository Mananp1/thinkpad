# ---------------------------------------------------------------------------
# Backend environment
# Copy this file to .env and fill in the values.
# .env is gitignored; this example file is committed.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# MongoDB connection string, including the database name at the end.
# The Note model (via mongoose) and Better Auth's user/session/account
# collections all live in this same database.
#   Local:  mongodb://127.0.0.1:27017/thinkpad
#   Atlas:  mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/thinkpad?retryWrites=true&w=majority
MONGO_URI=

# --- Better Auth -----------------------------------------------------------
# Secret used to sign session cookies. Must be at least 32 characters.
# Generate one with:  openssl rand -base64 32
# Changing this invalidates every existing session, logging all users out.
BETTER_AUTH_SECRET=KJsxf0jh6tDjNflK1hGaJuGOiPX1porZDgfhfOxO7GI

# The public, browser-reachable URL of THIS backend. No trailing slash.
# Better Auth builds its callback URLs from this and trusts its origin.
#   Local:       http://localhost:3000
#   Production:  https://thinkpad.example.com
BETTER_AUTH_URL=http://localhost:3000

# --- CORS ------------------------------------------------------------------
# Origin allowed to call this API with credentials. No trailing slash.
# In development this is the Vite dev server.
# In production, where Express serves the built SPA itself, set this to the
# same value as BETTER_AUTH_URL.
FRONTEND_URL=http://localhost:5173

# --- Server ----------------------------------------------------------------
# Port to listen on. Optional, defaults to 3000.
# Most hosts (Railway, Render, Fly) inject this automatically - if yours does,
# you can leave this unset.
PORT=3000
    