# MongoDB connection string, including the database name.
# Better Auth stores its user/session/account collections in this same database.
MONGO_URI=mongodb://127.0.0.1:27017/thinkpad

# Better Auth signing secret. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL this API is served from.
BETTER_AUTH_URL=http://localhost:3000

# Origin allowed to call the API with credentials (the Vite dev server).
FRONTEND_URL=http://localhost:5173

# Optional - defaults to 3000.
PORT=3000
