# Never ship secrets or host build output into the image.
**/.env
**/.env.local
**/.env.production
**/.env.development

**/node_modules
**/dist
**/build

# public/ is generated by the frontend build stage; excluding it keeps stale
# committed assets out of the image.
backend/public

.git
.gitignore
**/.gitignore
**/*.log
**/.vscode
**/.idea
**/.DS_Store
Dockerfile
.dockerignore
